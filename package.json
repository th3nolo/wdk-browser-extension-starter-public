{
  "name": "wdk-browser-extension-starter",
  "version": "0.2.4",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "description": "Chrome/Brave browser extension wallet starter built with Tether WDK.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "smoke:zip": "node scripts/zip-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "serve:test-dapp": "python3 -m http.server 8080",
    "postinstall": "wxt prepare",
    "smoke:chrome": "node scripts/chrome-extension-smoke.mjs --browser=cft",
    "smoke:chrome:dapp": "node scripts/chrome-extension-smoke.mjs --browser=cft --flow=dapp",
    "smoke:chrome:dapp:ui": "node scripts/chrome-extension-smoke.mjs --browser=cft --flow=dapp-ui",
    "smoke:manifest": "node scripts/manifest-smoke.mjs",
    "verify:extension": "node scripts/extension-verify.mjs",
    "verify:extension:sync": "node scripts/extension-verify.mjs --sync",
    "verify:extension:runtime": "node scripts/chrome-extension-smoke.mjs --browser=cft --flow=dapp",
    "verify:extension:ui": "node scripts/chrome-extension-smoke.mjs --browser=cft --flow=dapp-ui",
    "verify:themes": "node scripts/theme-smoke.mjs",
    "verify:secrets:history": "node scripts/history-secret-scan.mjs",
    "dev:load": "wxt build && node scripts/extension-verify.mjs --sync",
    "report:browsers": "node scripts/browser-matrix-report.mjs",
    "smoke:wdk": "node scripts/wdk-derivation-smoke.mjs",
    "smoke:wdk-surface": "node scripts/wdk-surface-smoke.mjs",
    "demo:gif": "node scripts/create-showcase-gif.mjs",
    "smoke:demo:gif": "node scripts/showcase-gif-smoke.mjs",
    "demo:video:showcase": "node scripts/create-showcase-video.mjs",
    "smoke:demo:showcase": "node scripts/showcase-video-smoke.mjs",
    "smoke:audit": "node scripts/audit-smoke.mjs",
    "smoke:wdk-deps": "node scripts/wdk-deps-smoke.mjs",
    "smoke:lockfile": "node scripts/lockfile-smoke.mjs",
    "review:lockfile": "node scripts/lockfile-review.mjs",
    "sync:audit-allowlist": "node scripts/sync-audit-allowlist.mjs",
    "check:wdk-beta": "node scripts/check-wdk-beta.mjs",
    "verify:ci": "node scripts/verify-ci.mjs",
    "setup:browser": "node scripts/setup-chrome-for-testing.mjs",
    "smoke:chromium": "node scripts/chrome-extension-smoke.mjs --browser=cft",
    "smoke:chrome:real": "node scripts/chrome-extension-smoke.mjs --browser=chrome",
    "smoke:brave": "node scripts/chrome-extension-smoke.mjs --browser=brave",
    "smoke:chrome:headed": "node scripts/chrome-extension-smoke.mjs --browser=cft --mode=headed-cdp",
    "smoke:chrome:real:headed": "node scripts/chrome-extension-smoke.mjs --browser=chrome --mode=headed-cdp",
    "smoke:brave:headed": "node scripts/chrome-extension-smoke.mjs --browser=brave --mode=headed-cdp"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@solana/addresses": "3.0.3",
    "@tetherto/wdk": "1.0.0-beta.9",
    "@tetherto/wdk-wallet-btc": "1.0.0-beta.9",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.9",
    "@tetherto/wdk-wallet-solana": "1.0.0-beta.9",
    "@tetherto/wdk-wallet-spark": "1.0.0-beta.9",
    "@zxcvbn-ts/core": "3.0.4",
    "@zxcvbn-ts/language-common": "3.0.4",
    "@zxcvbn-ts/language-en": "3.0.2",
    "bech32": "2.0.0",
    "bip39": "3.1.0",
    "bitcoinjs-lib": "6.1.7",
    "buffer": "6.0.3",
    "ethers": "6.14.4",
    "jsqr": "1.4.0",
    "lucide-react": "0.468.0",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sodium-universal": "5.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fontsource/chakra-petch": "5.2.7",
    "@fontsource/hanken-grotesk": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/manrope": "5.2.8",
    "@fontsource/sora": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@fontsource/space-mono": "5.2.9",
    "@fontsource/spectral": "5.2.8",
    "@types/chrome": "0.1.42",
    "@types/node": "22.19.19",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "29.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.60.0",
    "vitest": "2.1.9",
    "wxt": "0.20.26"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22 <23",
    "pnpm": "11.0.9"
  }
}
